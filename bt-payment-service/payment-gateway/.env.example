# .env.example
# This file serves as a template for configuring the application environment variables.
# Copy this file to '.env' and populate the actual secrets and configurations.
# DO NOT commit the actual '.env' file containing secrets to version control.

# Application General Config
ENV=development                  # Options: development, staging, production, testing
DEBUG=true                       # Set to false in production
PROJECT_NAME="BharatTruck Payment Service"
API_V1_STR="/api/v1"

# Server Host and Port Config
HOST=0.0.0.0
PORT=8000

# CORS Configuration
# Comma-separated list of origins allowed to access the API.
# In production, specify explicit domains instead of '*' (e.g., https://admin.bharattruck.com,https://api.bharattruck.com)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000"

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=payment_db

# SQLAlchemy connection URI. If provided, overrides individual DB_ host/user/pass fields.
# Format: postgresql://[user]:[password]@[host]:[port]/[db_name]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/payment_db"

# Logging Settings
# Verbosity options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Formatting options: json, text (json is highly recommended for production observability)
LOG_FORMAT=json

# Razorpay API Credentials (Required - microservice fails-fast on boot if missing/empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

