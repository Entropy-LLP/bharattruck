{
  "name": "bt-payment-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/index.ts",
    "dev:gateway": "cd payment-gateway && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "dev": "concurrently -n \"api,gateway\" -c \"cyan,magenta\" \"npm run dev:api\" \"npm run dev:gateway\"",
    "build": "tsc",
    "db:migrate": "cd payment-gateway && python -m alembic upgrade head",
    "start:api": "node dist/index.js",
    "start:gateway": "cd payment-gateway && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000",
    "start": "concurrently -n \"api,gateway\" -c \"cyan,magenta\" \"npm run start:api\" \"npm run start:gateway\""
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@supabase/supabase-js": "^2.43.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.3",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5"
  }
}
