PORT=3001
NODE_ENV=development

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-this-min-32-chars
JWT_REFRESH_SECRET=change-this-too-min-32-chars

# ── Phone OTP delivery (SMS) ─────────────────────────────────────────────────
# Unset, phone OTPs are printed to the server log and read out from there — which
# is the current pilot behaviour and stays the default. Real SMS is opt-in and
# all-or-nothing: SMS_PROVIDER must name a provider AND every credential that
# provider needs must be set, otherwise the service logs one warning at boot and
# falls back to the console. A half-filled config must not take phone login down.
#
# console | msg91. Leave unset for console.
# SMS_PROVIDER=msg91

# MSG91 credentials. THESE CANNOT BE OBTAINED FROM MSG91 ALONE — India's TRAI DLT
# regime gates commercial SMS, and registration takes weeks (docs/BLOCKERS.md B-2):
#   MSG91_AUTH_KEY     — MSG91 account auth key (the only one that is just a dashboard value)
#   MSG91_SENDER_ID    — the 6-char header REGISTERED on the DLT portal, e.g. BHTRUK
#   MSG91_TEMPLATE_ID  — id of a template PRE-APPROVED on DLT. Operators reject any
#                        message whose text does not match an approved template, and a
#                        run of rejections gets the sender header suspended.
# All three must be present or the service stays on the console provider.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_TEMPLATE_ID=

# Optional. The variable name the approved template exposes for the code — fixed at
# approval time (e.g. "Your BharatTruck code is ##OTP##"), so it must match what was
# registered rather than what we would have picked. Defaults to `otp`.
# MSG91_TEMPLATE_VAR=otp
# Optional. DLT template entity id, echoed on the send when the operator wants it.
# MSG91_DLT_TE_ID=
# Optional. Provider HTTP timeout in ms (default 8000) and base URL override.
# SMS_TIMEOUT_MS=8000
# MSG91_BASE_URL=https://control.msg91.com

# Force the console provider to print the [DEV] form of the OTP line outside
# NODE_ENV=development. Has no effect once a real provider is wired.
# OTP_DEV_MODE=true

# Google OAuth (get from Google Cloud Console → Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Password-changed security notice ─────────────────────────────────────────
# After a password reset, this service posts a 'password_changed' event to
# bt-booking-service's notification outbox (POST /internal/notifications). That is
# the email that tells a user their account was taken over — a reset they did not
# request is otherwise invisible to them, since the reset link goes to whoever
# asked for it. Both values must be set for the notice to be sent; unset, the
# reset itself still works and the emit is skipped silently.
BOOKING_SERVICE_URL=http://localhost:3002
INTERNAL_SERVICE_SECRET=

# Email SMTP (for email verification OTPs)
# Works with any SMTP provider: Gmail, SendGrid, AWS SES, Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_DEV_MODE=true

# ── Emailed front-end links, per role ────────────────────────────────────────
# Each persona is a separate Next app on its own origin, so an emailed link is built
# from the ACCOUNT's role — a driver who signs in via the shipper app is still sent to
# the driver app. A callback_url in the request body takes precedence over all of these.
#
# Point these at the deployed front-ends, NOT at a stale preview deployment: whatever is
# here is what lands in a real user's inbox.
SHIPPER_MAGIC_LINK_URL=http://localhost:3000/auth/callback
DRIVER_MAGIC_LINK_URL=http://localhost:3002/auth/callback
# Fleet console has no /auth pages yet — leave unset and fleet owners fall through to the
# shipper app, whose callback/reset pages are role-agnostic and complete the flow fine.
# FLEET_MAGIC_LINK_URL=

# Password reset. If unset, the reset page is DERIVED from the magic-link URL above by
# swapping the path to /auth/reset — set these only when the reset page lives somewhere
# that swap would not find. Never point them at /auth/callback: that page forwards its
# token to /auth/magic-link/verify, which rejects a reset token and dead-ends the flow.
# SHIPPER_RESET_PASSWORD_URL=http://localhost:3000/auth/reset
# DRIVER_RESET_PASSWORD_URL=http://localhost:3002/auth/reset
# FLEET_RESET_PASSWORD_URL=

# ── Auth throttles ───────────────────────────────────────────────────────────
# All optional — the defaults shown are what the service uses when unset. Keyed on
# the EMAIL, never the client IP: `req.ip` here is the bt-gateway container, so an
# IP-keyed limit would put the whole pilot on one counter.

# Wrong passwords tolerated per account before password login is refused. Only
# failures count and a success clears the tally, so a user who knows their password
# is never throttled. A locked account can still get in via magic link.
LOGIN_FAIL_LIMIT=10
LOGIN_FAIL_WINDOW_S=900

# Wrong OTP codes tolerated per address before the live code is burned (forcing a
# fresh, separately-throttled request).
OTP_VERIFY_LIMIT=5

# Messages sent to any one address per window, across every email-producing route.
EMAIL_SEND_LIMIT=5
EMAIL_SEND_WINDOW_S=3600

# Total messages this service may send per UTC day. This is the ceiling that stops a
# quota drain: registration accepts any address, so an attacker spreads sends across
# thousands of addresses and never trips the per-address counter. Raise it before a
# campaign — when it is hit, real users stop receiving verification codes too.
SMTP_DAILY_BUDGET=500
