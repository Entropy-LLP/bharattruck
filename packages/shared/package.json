{
  "name": "@bharattruck/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared libraries for BharatTruck services — reused cross-cutting code lives HERE, not copy-pasted per service (error envelope, auth/JWT, Supabase service-role client, Redis, Fastify bootstrap, env/config validation).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./errors": { "types": "./dist/errors.d.ts", "import": "./dist/errors.js" },
    "./auth": { "types": "./dist/auth.d.ts", "import": "./dist/auth.js" },
    "./db": { "types": "./dist/db.d.ts", "import": "./dist/db.js" },
    "./fleet": { "types": "./dist/fleet.d.ts", "import": "./dist/fleet.js" }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --test --experimental-strip-types"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.4",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.6",
    "typescript": "^5.4.5"
  }
}
